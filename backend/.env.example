PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/golden-cuts
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: if you want the AI Assistant to use a real LLM for natural language
# understanding (recommended). Without this, the AI falls back to rule-based
# keyword/date parsing, which still uses 100% real database data for every answer.
ANTHROPIC_API_KEY=
